<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>SAIN</RootNamespace>
    <AssemblyName>SAIN</AssemblyName>
    <ReleaseOutputDir>..\Build\BepInEx\plugins\SAIN\</ReleaseOutputDir>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
  </PropertyGroup>

  <!-- targets -->
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <None Include="References\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAIN.Preset.Shared\SAIN.Preset.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\References\hollowed.dll</HintPath>
    </Reference>
    <Reference Include="bsg.console.core">
      <HintPath>..\References\bsg.console.core.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>..\References\Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Comfort.Unity">
      <HintPath>..\References\Comfort.Unity.dll</HintPath>
    </Reference>
    <Reference Include="CommonExtensions" HintPath="..\References\CommonExtensions.dll" Private="false" />
    <Reference Include="DissonanceVoip" HintPath="..\References\DissonanceVoip.dll" Private="false" />
    <Reference Include="DrakiaXYZ-BigBrain">
      <HintPath>..\References\DrakiaXYZ-BigBrain.dll</HintPath>
    </Reference>
    <Reference Include="ItemComponent.Types" HintPath="..\References\ItemComponent.Types.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="..\References\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="Sirenix.Serialization">
      <HintPath>..\References\Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="websocket-sharp" HintPath="..\References\websocket-sharp.dll" Private="false" />
    <Reference Include="spt-common">
      <HintPath>..\References\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-core">
      <HintPath>..\References\spt-core.dll</HintPath>
    </Reference>
    <Reference Include="spt-custom">
      <HintPath>..\References\spt-custom.dll</HintPath>
    </Reference>
    <Reference Include="spt-debugging">
      <HintPath>..\References\spt-debugging.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>..\References\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="spt-singleplayer">
      <HintPath>..\References\spt-singleplayer.dll</HintPath>
    </Reference>
    <Reference Include="Unity.Postprocessing.Runtime">
      <HintPath>..\References\Unity.Postprocessing.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\References\UnityEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Fork: deploy to the game. TarkovDir comes from SAIN.csproj.user (not committed). Opt out with -p:DeployToGame=false -->
  <PropertyGroup>
    <TarkovDir Condition="'$(TarkovDir)' == ''">C:\SPT Stuff\SPT 4160\</TarkovDir>
  </PropertyGroup>
  <Target Name="DeployToGameDir" AfterTargets="CopyBuildOutput" Condition="'$(DeployToGame)' != 'false'">
    <PropertyGroup>
      <PluginDeployDir>$(TarkovDir)BepInEx\plugins\SAIN\</PluginDeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginDeployDir)" />
    <!-- .orig = first DLL ever replaced, never overwritten; .bak = previous deploy. A loaded DLL can be renamed but not overwritten. -->
    <Copy SourceFiles="$(PluginDeployDir)SAIN.dll" DestinationFiles="$(PluginDeployDir)SAIN.dll.orig"
          Condition="Exists('$(PluginDeployDir)SAIN.dll') And !Exists('$(PluginDeployDir)SAIN.dll.orig')" />
    <Copy SourceFiles="$(PluginDeployDir)SAIN.Preset.Shared.dll" DestinationFiles="$(PluginDeployDir)SAIN.Preset.Shared.dll.orig"
          Condition="Exists('$(PluginDeployDir)SAIN.Preset.Shared.dll') And !Exists('$(PluginDeployDir)SAIN.Preset.Shared.dll.orig')" />
    <Delete Files="$(PluginDeployDir)SAIN.dll.bak;$(PluginDeployDir)SAIN.Preset.Shared.dll.bak" ContinueOnError="true" />
    <Move SourceFiles="$(PluginDeployDir)SAIN.dll" DestinationFiles="$(PluginDeployDir)SAIN.dll.bak"
          Condition="Exists('$(PluginDeployDir)SAIN.dll')" />
    <Move SourceFiles="$(PluginDeployDir)SAIN.Preset.Shared.dll" DestinationFiles="$(PluginDeployDir)SAIN.Preset.Shared.dll.bak"
          Condition="Exists('$(PluginDeployDir)SAIN.Preset.Shared.dll')" />
    <Copy SourceFiles="$(ReleaseOutputDir)SAIN.dll;$(ReleaseOutputDir)SAIN.Preset.Shared.dll" DestinationFolder="$(PluginDeployDir)" />
  </Target>

  <!-- Build script-->
  <Target Name="CleanUnwantedFiles" AfterTargets="Build">
    <ItemGroup>
      <UnwantedFiles
        Include="$(OutputPath)*.pdb; $(OutputPath)*.deps.json; $(OutputPath)*.dll"
        Exclude="$(OutputPath)SAIN.dll;$(OutputPath)SAIN.Preset.Shared.dll"
      />
    </ItemGroup>
    <Delete Files="@(UnwantedFiles)" />
  </Target>
  <Target Name="CopyBuildOutput" AfterTargets="CleanUnwantedFiles">
    <MakeDir Directories="$(ReleaseOutputDir)" />
    <ItemGroup>
      <RemainingFiles Include="$(OutputPath)**\*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(RemainingFiles)"
      DestinationFiles="@(RemainingFiles->'$(ReleaseOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
    />
  </Target>
</Project>
